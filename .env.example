# Origine HTTPS définitive, sans chemin ni port.
NEXT_PUBLIC_SITE_URL=
# Activer uniquement pour le domaine public définitif.
SITE_INDEXING_ENABLED=false
# Facultatif : valeur content de la balise de validation d’une propriété avec préfixe d’URL.
GOOGLE_SITE_VERIFICATION=
# Téléphone public (au format international) et profil Facebook. Les champs vides utilisent les valeurs publiques.
SALON_PHONE=
SALON_FACEBOOK_URL=
# Numéro de réservation SMS à confirmer, au format international. Laisser vide pour masquer l’action.
SALON_SMS=
# Facultatif : remplace l’adresse publique de l’institut si elle change.
SALON_STREET_ADDRESS=

